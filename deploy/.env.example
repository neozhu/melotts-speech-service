# Local build: docker compose --env-file deploy/.env -f deploy/compose.yaml build
TTS_IMAGE=melotts-speech-service:local
# After release, prefer ghcr.io/neozhu/melotts-speech-service@sha256:<verified-digest>
API_KEY=replace-with-a-long-random-secret
TTS_PORT=8000
TTS_LANGUAGES=ZH,EN
TTS_PRELOAD_LANGUAGES=ZH
TTS_DEFAULT_VOICE=zh
TTS_MAX_TEXT_LENGTH=500
TTS_MAX_QUEUE=4
TTS_QUEUE_TIMEOUT_SECONDS=120
TTS_ENCODE_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
